---
/**
 * OPTION 3 — DOCKING BAY (hub and spoke)
 * The front door is almost empty: a schematic core with three ports.
 * Each port is its own page. Phase 1: structure only, no motion.
 */
import Proto from "../../../../layouts/Proto.astro";
import { projects } from "../../../../data/projects";
import { writing } from "../../../../data/writing";
import { lab } from "../../../../data/lab";

const ports = [
	{
		slug: "projects",
		idx: "A",
		name: "Projects",
		count: projects.length,
		unit: "live",
		note: "Things running on their own subdomains.",
		accent: "red",
	},
	{
		slug: "writing",
		idx: "B",
		name: "Writing",
		count: writing.length,
		unit: "pieces",
		note: "Essays, teardowns, field notes.",
		accent: "orange",
	},
	{
		slug: "lab",
		idx: "C",
		name: "Lab",
		count: lab.length,
		unit: "studies",
		note: "Small motion experiments, one idea each.",
		accent: "blue",
	},
];
---

<Proto title="Hub / Option 3 — Docking Bay" section="hub" motion={false}>
	<div class="bay-page">
		<div class="shell">
			<div class="bay-page__meta mono">
				<span>COSMIC STRAWBERRY / DOCKING BAY</span>
				<span>SELECT A PORT</span>
			</div>
			<div class="rule"></div>

			<div class="core">
				<!-- the core schematic: one body, three ports -->
				<svg class="schema core__fig" viewBox="0 0 320 320" role="img" aria-label="Docking core with three ports">
					<circle class="ln ln--faint" cx="160" cy="160" r="128" />
					<circle class="ln" cx="160" cy="160" r="46" />
					<circle class="ln ln--faint" cx="160" cy="160" r="22" />
					<line class="ln ln--dash" x1="160" y1="14" x2="160" y2="306" />
					<line class="ln ln--dash" x1="14" y1="160" x2="306" y2="160" />

					<!-- port A, top -->
					<line class="ln" x1="160" y1="114" x2="160" y2="52" />
					<rect class="ln" x="142" y="30" width="36" height="22" />
					<rect class="fill-red" x="156" y="38" width="8" height="6" />

					<!-- port B, lower right -->
					<line class="ln" x1="200" y1="183" x2="254" y2="214" />
					<rect class="ln" x="248" y="214" width="36" height="22" />
					<rect class="fill-orange" x="262" y="222" width="8" height="6" />

					<!-- port C, lower left -->
					<line class="ln" x1="120" y1="183" x2="66" y2="214" />
					<rect class="ln" x="36" y="214" width="36" height="22" />
					<rect class="fill-blue" x="50" y="222" width="8" height="6" />

					<text class="txt txt--lead" x="160" y="164" text-anchor="middle">CS</text>
					<text class="txt" x="186" y="26" text-anchor="start">A</text>
					<text class="txt" x="292" y="210" text-anchor="start">B</text>
					<text class="txt" x="28" y="210" text-anchor="end">C</text>
				</svg>

				<h1 class="core__word display">Hub</h1>
			</div>

			<nav class="ports" aria-label="Sections">
				{
					ports.map((p) => (
						<a
							class="port"
							href={`/proto/hub/option-3/${p.slug}`}
							data-accent={p.accent}
							data-cursor="Dock →"
						>
							<span class="port__head mono">
								<span class="marker__idx">{p.idx}</span>
								<span class="port__count">
									{p.count} {p.unit}
								</span>
							</span>
							<span class="port__name h3">{p.name}</span>
							<span class="port__note">{p.note}</span>
							<span class="port__bar" aria-hidden="true" />
						</a>
					))
				}
			</nav>

			<p class="mono ports__note">
				A NEW SECTION IS A NEW PORT — THE FRONT DOOR NEVER GETS LONGER, ONLY WIDER.
			</p>
		</div>
	</div>
</Proto>

<style>
	.bay-page {
		min-height: 100svh;
		padding-block: 7rem var(--s-8);
		display: flex;
		align-items: center;
	}

	.bay-page__meta {
		display: flex;
		justify-content: space-between;
		gap: var(--s-4);
		padding-bottom: var(--s-2);
	}

	.core {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--s-6);
		padding-block: var(--s-6);
	}

	.core__fig {
		max-width: 340px;
		margin-inline: auto;
	}

	.core__word {
		font-size: clamp(4rem, 12vw, 10rem);
		text-align: right;
	}

	/* ---- ports ---- */
	.ports {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--hair);
		background: var(--rule);
		border-block: var(--hair) solid var(--rule-strong);
	}

	.port {
		background: var(--bg);
		padding: var(--s-3) var(--s-3) var(--s-4);
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
		position: relative;
		transition: background-color 0.35s var(--ease);
	}

	.port[data-accent="red"] {
		--port-accent: var(--cs-red);
	}
	.port[data-accent="orange"] {
		--port-accent: var(--cs-orange);
	}
	.port[data-accent="blue"] {
		--port-accent: var(--cs-blue);
	}

	.port:hover,
	.port:focus-visible {
		background: var(--bg-panel);
		outline: none;
	}

	.port__head {
		display: flex;
		justify-content: space-between;
		font-family: var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.7rem;
		color: var(--fg-mute);
	}

	.port__count {
		color: var(--fg-faint);
	}

	.port__name {
		margin-top: var(--s-2);
		transition: color 0.3s var(--ease);
	}

	.port:hover .port__name {
		color: var(--port-accent);
	}

	.port__note {
		font-size: 0.875rem;
		color: var(--fg-mute);
		max-width: 28ch;
	}

	.port__bar {
		position: absolute;
		inset: auto 0 0 0;
		height: 4px;
		background: var(--port-accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.4s var(--ease);
	}

	.port:hover .port__bar,
	.port:focus-visible .port__bar {
		transform: scaleX(1);
	}

	.ports__note {
		margin-top: var(--s-3);
		color: var(--fg-faint);
	}

	@media (max-width: 900px) {
		.core {
			grid-template-columns: minmax(0, 1fr);
		}

		.core__word {
			text-align: left;
		}

		.ports {
			grid-template-columns: minmax(0, 1fr);
		}

		.bay-page {
			min-height: 0;
		}
	}
</style>
