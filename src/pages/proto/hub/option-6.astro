---
/**
 * OPTION 6 — THE DECK  (close translation of the DUB Studios reference)
 *
 * Full viewport, nothing scrolls. Chrome is fixed: wordmark, section rail,
 * counter, drag control. The world moves under it.
 *
 *   left / right  →  items inside a section
 *   up   / down   →  section to section
 *
 * Which is exactly the hub's IA: distinct sections, one page, traversed
 * rather than scrolled. Each item alternates which side its figure sits on,
 * and a ghosted word sits behind the whole cell.
 */
import Proto from "../../../layouts/Proto.astro";
import SchemaMark from "../../../components/proto/SchemaMark.astro";
import SchemaCore from "../../../components/proto/SchemaCore.astro";
import { projects } from "../../../data/projects";
import { writing } from "../../../data/writing";
import { lab } from "../../../data/lab";

interface Cell {
	idx: string;
	kicker: string;
	title: string;
	blurb: string;
	meta: string;
	byline: string;
	href: string | null;
	external: boolean;
	variant: "stack" | "orbit" | "trace" | "nozzle";
	accent: string;
	ghost: string;
	cta: string;
}

const rows: { num: string; name: string; cells: Cell[] }[] = [
	{
		num: "01",
		name: "Projects",
		cells: projects.map((p) => ({
			idx: p.idx,
			kicker: "project",
			title: p.name,
			blurb: p.blurb,
			meta: p.tags.join(" / "),
			byline: p.host,
			href: p.href,
			external: true,
			variant: p.variant,
			accent: p.accent,
			ghost: p.keyword,
			cta: "Launch",
		})),
	},
	{
		num: "02",
		name: "Writing",
		cells: writing.map((w) => ({
			idx: w.idx,
			kicker: w.kind.toLowerCase(),
			title: w.title,
			blurb: w.blurb,
			meta: `${w.minutes} min`,
			byline: w.date,
			href: w.href,
			external: false,
			variant: w.variant,
			accent: "orange",
			ghost: w.kind,
			cta: "Read",
		})),
	},
	{
		num: "03",
		name: "Lab",
		cells: lab.map((l, i) => ({
			idx: l.idx,
			kicker: "study",
			title: l.name,
			blurb: l.note,
			meta: l.state,
			byline: l.state === "built" ? "demo up" : "on paper",
			href: l.href,
			external: false,
			variant: (["trace", "stack", "orbit", "nozzle"] as const)[i % 4],
			accent: "blue",
			ghost: "Lab",
			cta: "Run",
		})),
	},
];

/*
 * The rail lists the masthead alongside the three content sections — it is a
 * row like any other as far as the deck is concerned, so it has to be one
 * here too or the dots stop lining up with what they drive.
 */
const nav = [{ num: "00", name: "Masthead" }, ...rows.map((r) => ({ num: r.num, name: r.name }))];
---

<Proto title="Hub / Option 6 — Deck" section="hub" motion="manual">
	<div
		class="deck is-booting"
		data-deck
		data-accent="mast"
		role="region"
		tabindex="0"
		aria-label="Cosmic Strawberry hub, use arrow keys to move"
	>
		{/* the drafting table the world moves over — parallaxes, never scrolls */}
		<div class="deck__grid" aria-hidden="true"></div>

		<!-- ============ the world that moves ============ -->
		<div class="deck__world" data-world>
			{/* ---- 00 / the masthead: the front door, before any of the work ---- */}
			<div class="deck__row" id="deck-row-00" data-row data-section="Masthead" data-num="00">
				<div
					class="cell cell--mast"
					data-cell
					data-title="Cosmic Strawberry"
					data-accent="mast"
				>
					<span class="cell__ghost" data-ghost aria-hidden="true">
						<span class="cell__ghost-in" data-par="0.05">Hub</span>
					</span>

					<div class="mast" data-no-drag>
						<div class="mast__meta mono" data-line>
							<span>COSMIC STRAWBERRY / PERSONAL TRANSMISSION</span>
							<span>EST. 2026 &mdash; RA 14H 29M / DEC &minus;62&deg; 40&prime;</span>
							<span>SIG ◉ LOCKED</span>
						</div>
						<div class="rule"></div>

						<div class="mast__word" data-par="0.018">
							<h1 class="display" data-line>
								<span>Cosmic</span><span>Strawberry</span>
							</h1>
						</div>

						<div class="stripe mast__stripe" aria-hidden="true">
							<span></span><span></span><span></span>
						</div>

						<div class="mast__body">
							<div class="mast__thesis">
								<p class="lede" data-line>
									Projects, writing, and the bench work in between &mdash; three
									sections, one screen, traversed rather than scrolled.
								</p>

								<dl class="mast__specs mono" data-line>
									<div class="spec">
										<dt>Operator</dt>
										<dd>Jermbo</dd>
									</div>
									<div class="spec">
										<dt>Sections</dt>
										<dd>{rows.length}</dd>
									</div>
									<div class="spec">
										<dt>Entries</dt>
										<dd>{rows.reduce((n, r) => n + r.cells.length, 0)}</dd>
									</div>
									<div class="spec">
										<dt>Traverse</dt>
										<dd>&larr; &rarr; &uarr; &darr;</dd>
									</div>
								</dl>
							</div>

							<figure class="mast__figure" data-line>
								<SchemaCore />
								<figcaption class="mono">
									<span>FIG. 1 &mdash; CORE SECTION</span>
									<span>SHEET 01 / 03</span>
								</figcaption>
							</figure>
						</div>
					</div>
				</div>
			</div>

			{
				rows.map((r) => (
					<div class="deck__row" id={`deck-row-${r.num}`} data-row data-section={r.name} data-num={r.num}>
						<h2 class="sr">{r.name}</h2>
						{r.cells.map((c, i) => (
							<div
								class="cell"
								data-cell
								data-title={c.title}
								data-accent={c.accent}
								data-flip={i % 2 === 1 ? "true" : "false"}
							>
								<div class="cell__ghost" data-ghost aria-hidden="true">
									<span class="cell__ghost-in" data-par="0.05">{c.ghost}</span>
								</div>

								<div class="cell__panel" data-panel>
									<span class="cell__fig">
										<SchemaMark variant={c.variant} label={`${c.title} schematic`} />
									</span>
									<div class="cell__stamp mono" data-line>
										<span class="cell__kicker">{c.kicker}</span>
										<span class="cell__byline">{c.byline}</span>
									</div>
								</div>

								<div class="cell__type" data-par="0.018" data-no-drag>
									<h3 class="cell__title" data-line>{c.title}</h3>
									<p class="cell__blurb" data-line>{c.blurb}</p>

									<div class="cell__meta mono" data-line>
										<span>{c.meta}</span>
									</div>

									{/* the only control in the cell; the copy around it is selectable */}
									{c.href && (
										<a
											class="launch"
											data-launch
											data-magnet
											data-no-drag
											href={c.href}
											target={c.external ? "_blank" : undefined}
											rel={c.external ? "noopener" : undefined}
											data-cursor={`${c.cta} \u2197`}
										>
											<span class="launch__dot" aria-hidden="true" />
											<span class="launch__label">
												{c.cta}
												<span aria-hidden="true">{c.external ? "\u2197" : "\u2192"}</span>
											</span>
											<span class="sr">{c.title}{c.external ? " (opens in a new tab)" : ""}</span>
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				))
			}
		</div>

		<!-- ============ fixed chrome ============ -->
		<div class="rail">
			<span class="rail__num mono" data-rail-index>01</span>
			<span class="rail__line" aria-hidden="true"></span>
			<span class="rail__num rail__num--dim mono" data-rail-total>04</span>
		</div>

		<nav class="sections mono" aria-label="Hub sections">
			<ul>
				{
					nav.map((r) => (
						<li>
							<button
								type="button"
								data-section-dot
								data-cursor={r.name}
								aria-controls={`deck-row-${r.num}`}
							>
								<span class="sections__num" aria-hidden="true">{r.num}</span>
								<span class="sections__name">{r.name}</span>
							</button>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="now mono">
			<span class="now__num" data-rail-section-num>00</span>
			<span class="now__name" data-rail-section>Masthead</span>
		</div>

		<div class="drag mono">
			<button type="button" data-go-prev aria-label="Previous item" data-cursor="Back">‹</button>
			<span class="drag__label">move</span>
			<button type="button" data-go-next aria-label="Next item" data-cursor="Forward">›</button>
		</div>

		<button class="down mono" type="button" data-go-down data-cursor="Next section">
			<span>scroll down to navigate</span>
		</button>

		{/* the stripe doubles as a progress bar through the current section */}
		<div class="deck__progress" aria-hidden="true">
			<div class="stripe deck__stripe" data-progress>
				<span></span><span></span><span></span>
			</div>
		</div>

		{/* the signal-lock sweep — boot only, never on a loop */}
		<div class="deck__scan" data-scan aria-hidden="true"></div>

		{/* one polite announcement per move, for anyone not watching it happen */}
		<p class="sr" role="status" aria-live="polite" data-status></p>

		<p class="sr">
			Use the left and right arrow keys to move between items, up and down to move between
			sections, Home and End for the first and last item in a section.
		</p>
	</div>
</Proto>

<script>
	import { initDeck } from "../../../lib/proto/hub/deck";
	import { initPlay } from "../../../lib/proto/hub/play";
	import { playDeckBoot } from "../../../lib/proto/hub/boot";

	/*
	 * `motion="manual"` means the layout has settled nothing — this page owns
	 * its load end to end. The deck wires itself up without playing its own
	 * arrival, the boot performs that first arrival as one timeline, and every
	 * row after this one draws its line-work when it is first entered.
	 */
	const start = () => {
		initDeck({ intro: false, drawFigures: true, scrambleGhost: true, drag: "touch" });
		initPlay();
		playDeckBoot();

		/* transitions were suppressed so the first paint could not cross-fade */
		requestAnimationFrame(() => {
			document.querySelector("[data-deck]")?.classList.remove("is-booting");
		});
	};

	/* the wordmark is split into lines, so it must not be split against a fallback face */
	if (document.fonts?.ready) {
		document.fonts.ready.then(start);
	} else {
		start();
	}
</script>

<style>
	/* ================= the deck ================= */
	.deck {
		position: fixed;
		inset: 0;
		overflow: hidden;
		/*
		 * `pinch-zoom`, not `none`. The swipe still reaches our handler, but
		 * the browser keeps the pinch — taking that away from a touch user is
		 * taking away their magnifier.
		 */
		touch-action: pinch-zoom;
	}

	/* a real focus ring — the deck is the thing arrow keys drive */
	.deck:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: -4px;
	}

	/*
	 * The drag surface cannot be selected, or every pan would smear a selection
	 * across the copy. But the copy itself must stay selectable: a text-to-speech
	 * user selects a paragraph to have it read aloud, and a deck that is one
	 * unbroken drag handle takes that away. So the type blocks opt out of the
	 * drag with `data-no-drag` and keep normal selection; the panel, the ghost
	 * word and the margins remain the handle.
	 */
	.deck,
	.cell {
		user-select: none;
		-webkit-user-select: none;
	}

	.cell [data-no-drag] {
		user-select: text;
		-webkit-user-select: text;
	}

	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/*
	 * The construction grid. Fixed like the rest of the chrome, but drifting
	 * against the world at a twelfth of its rate, so the deck reads as a
	 * surface being moved over rather than a stack of panels being swapped.
	 * `--travel-*` and `--lean` are published by the deck; the rates are the
	 * page's decision.
	 */
	.deck__grid {
		position: absolute;
		/* overscan, so parallax and drag never expose an edge */
		inset: -12%;
		z-index: 0;
		pointer-events: none;
		/*
		 * Faint enough that the line-work always wins; it is ground, not figure.
		 * Light needs more of it: the same alpha reads far weaker as ink on
		 * cream than it does as cream on ink.
		 */
		opacity: 0.6;
		/*
		 * Travel only. Transitioned at the deck's own 0.78s so the grid and the
		 * world arrive together.
		 */
		transform: translate3d(
			calc(var(--travel-x, 0px) / 12),
			calc(var(--travel-y, 0px) / 12),
			0
		);
		/*
		 * `--ease` is a quint-ish curve; the deck moves on GSAP's `expo.out`.
		 * Matching only the duration left the grid visibly drifting against the
		 * world for most of the move, so this is the CSS approximation of
		 * expo-out rather than the shared token.
		 */
		transition: transform 0.78s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}

	/*
	 * The drafting grid itself, on its own layer so lean can be applied without
	 * a transition. `--lean` is rewritten every frame of a drag and is already
	 * spring-smoothed by the deck; a 0.78s transition on top of that would
	 * smooth a smoothed value and the grid would lag the hand holding it.
	 */
	.deck__grid::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: /* minor rule */ linear-gradient(
				var(--rule) var(--hair),
				transparent var(--hair)
			),
			linear-gradient(90deg, var(--rule) var(--hair), transparent var(--hair)),
			/* major rule, every fifth */ linear-gradient(
				var(--rule-strong) var(--hair),
				transparent var(--hair)
			), linear-gradient(90deg, var(--rule-strong) var(--hair), transparent var(--hair));
		background-size: 40px 40px, 40px 40px, 200px 200px, 200px 200px;
		transform: translate3d(calc(var(--lean, 0) * 22px), 0, 0);
		will-change: transform;
	}

	:global([data-theme="dark"]) .deck__grid {
		opacity: 0.3;
	}

	.deck__world {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		will-change: transform;
	}

	/*
	 * One sweep, during the boot's register beat, and then it is gone. The
	 * exception to "nothing plays on a timer" is bought here and nowhere else —
	 * a permanent scanline is wallpaper you stop seeing on the second visit.
	 */
	.deck__scan {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: var(--hair);
		background: var(--fg);
		opacity: 0;
		z-index: 40;
		pointer-events: none;
	}

	/*
	 * Exactly one viewport tall, never more. The deck steps the world by
	 * deck.clientHeight, so a row that grows to fit its content — the
	 * masthead is the only one that can — silently desyncs every row below
	 * it. The cap is what keeps that arithmetic true.
	 */
	.deck__row {
		flex: 0 0 100%;
		min-height: 0;
		max-height: 100%;
		display: flex;
		align-items: stretch;
		will-change: transform;
	}

	/* ================= a cell ================= */
	.cell {
		position: relative;
		/* narrower than the viewport, so the next one peeks in at the edge */
		flex: 0 0 86vw;
		margin-right: 4vw;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
		/* the inline padding is the margin the fixed rails live in */
		padding: 7rem clamp(4.5rem, 8vw, 8rem) 8rem;
		opacity: 0.24;
		transition: opacity 0.7s var(--ease);
	}

	.cell.is-active {
		opacity: 1;
	}

	/*
	 * At 200% text zoom the masthead needs 1343px in a 512px box, and
	 * `overflow: hidden` simply cut it off — WCAG 1.4.4 and 1.4.10, failed. The
	 * cell scrolls itself when its content does not fit. The wheel handler
	 * checks for exactly this and yields rather than moving the deck.
	 */
	.cell {
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.cell:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: -1rem;
	}

	.cell[data-accent="red"] {
		--cell-accent: var(--cs-red);
	}
	.cell[data-accent="orange"] {
		--cell-accent: var(--cs-orange);
	}
	.cell[data-accent="blue"] {
		--cell-accent: var(--cs-blue);
	}

	/* every other item puts its type on the left */
	.cell[data-flip="true"] {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
	}

	.cell[data-flip="true"] .cell__panel {
		order: 2;
	}

	.cell[data-flip="true"] .cell__type {
		order: 1;
		text-align: right;
	}

	.cell[data-flip="true"] .cell__meta {
		justify-content: flex-end;
	}

	.cell[data-flip="true"] .cell__type {
		align-items: flex-end;
	}

	/* ================= 00 / the masthead ================= */

	/*
	 * Row 00 is the proto index hero, re-cut to live inside a cell: full
	 * viewport width rather than 86vw, because there is no next item in this
	 * section to peek in at the edge, and centred vertically because the
	 * deck never scrolls to reveal what a page hero would put below the fold.
	 */
	.cell--mast {
		flex: 0 0 100vw;
		margin-right: 0;
		height: 100%;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: center;
		padding: 5rem clamp(2rem, 6vw, 6rem) 5.5rem;
	}

	.mast {
		position: relative;
		z-index: 2;
		width: min(100%, var(--maxw));
		margin-inline: auto;
		display: flex;
		flex-direction: column;
	}

	.mast__meta {
		display: flex;
		justify-content: space-between;
		gap: var(--s-3);
		padding-bottom: var(--s-2);
		flex-wrap: wrap;
	}

	.mast__word {
		position: relative;
		margin-top: var(--s-3);
	}

	/*
	 * The index hero can afford 13.5vw because the page scrolls. Here the
	 * wordmark, the stripe, the lede and the spec table all have to clear one
	 * viewport, so the type is capped against height as well as width.
	 */
	.mast__word .display {
		font-size: clamp(2.5rem, min(10.5vw, 13.5vh), 9rem);
	}

	.mast__word .display,
	.mast__word .display span {
		display: block;
	}

	.mast__stripe {
		--stripe-h: clamp(10px, 1.3vw, 16px);
		margin: var(--s-3) 0 var(--s-4);
	}

	.mast__body {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		align-items: start;
	}

	.mast__thesis {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
	}

	.mast__figure {
		margin: 0;
		width: 100%;
		max-width: 22rem;
		margin-left: auto;
		/* the schematic answers the drag exactly as the cell panels do */
		transform: rotate(calc(var(--lean, 0) * -1.6deg))
			translateX(calc(var(--lean, 0) * -10px));
	}

	.mast__figure :global(.schema) {
		width: 100%;
		max-height: 26vh;
	}

	.mast__figure figcaption {
		margin-top: var(--s-2);
		padding-top: var(--s-1);
		border-top: var(--hair) solid var(--rule);
		display: flex;
		justify-content: space-between;
		gap: var(--s-2);
	}

	.mast__specs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--s-2) var(--s-3);
		margin: var(--s-2) 0 0;
		max-width: 34ch;
	}

	/*
	 * On row 00 the item rail, the drag prompt and the "you are here" readout
	 * all describe a section of one, so they say nothing true. The down
	 * affordance is the only control that means anything here, and it stays.
	 */
	.deck[data-accent="mast"] .rail,
	.deck[data-accent="mast"] .drag,
	.deck[data-accent="mast"] .now {
		opacity: 0;
		pointer-events: none;
	}

	.rail,
	.drag,
	.now {
		transition: opacity 0.5s var(--ease);
	}

	.cell[data-accent="mast"] {
		--cell-accent: var(--cs-red);
	}

	/*
	 * The first painted frame must already be the pre-boot state. Without this
	 * the deck cross-fades into itself: the masthead transitions up from the
	 * inactive 0.24, and the chrome fades out as `data-accent` resolves —
	 * two fades, in a load whose whole point is that nothing fades.
	 */
	.deck.is-booting .cell,
	.deck.is-booting .rail,
	.deck.is-booting .drag,
	.deck.is-booting .now {
		transition: none;
	}

	.deck.is-booting .cell--mast {
		opacity: 1;
	}

	/*
	 * The masthead's copy is hidden for exactly as long as it takes the boot
	 * to claim it. Without this the type paints, then snaps out when the
	 * timeline applies its from-states — visible on any slow font load.
	 * Same bargain the rest of the system makes with `html.js [data-reveal]`:
	 * hidden only while scripting is expected to arrive.
	 */
	html.js .deck.is-booting .mast__meta span,
	html.js .deck.is-booting .display,
	html.js .deck.is-booting .lede,
	html.js .deck.is-booting .mast__specs,
	html.js .deck.is-booting .mast__figure figcaption {
		opacity: 0;
	}

	/* ================= the launch zone ================= */

	/*
	 * The only navigating element in the cell. Everything else is drag
	 * surface, which is the whole reason this is a small target rather than
	 * the old full-cell anchor.
	 */
	.launch {
		align-self: flex-start;
		margin-top: var(--s-2);
		display: inline-flex;
		align-items: center;
