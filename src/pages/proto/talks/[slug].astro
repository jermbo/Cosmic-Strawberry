---
import Talk from "../../../layouts/Talk.astro";
import TalkShow from "../../../components/talk/TalkShow.astro";
import { loadTalk, slugFromPath } from "../../../lib/proto/talks/load";
import type { TalkDoc } from "../../../lib/proto/talks/ast";
import type { TalkMeta } from "../../../lib/proto/talks/load";

export function getStaticPaths() {
	const sources = import.meta.glob<string>("../../../content/talks/*.md", {
		query: "?raw",
		import: "default",
		eager: true,
	});

	return Object.entries(sources).flatMap(([path, source]) => {
		const slug = slugFromPath(path);
		if (!slug) return [];
		const { meta, doc } = loadTalk(source);
		return [{ params: { slug }, props: { meta, doc } }];
	});
}

interface Props {
	meta: TalkMeta;
	doc: TalkDoc;
}

const { meta, doc } = Astro.props;
---

<Talk title={`${meta.title} — ${meta.series}`} desc={meta.description}>
	<TalkShow title={meta.title} doc={doc} />
</Talk>
