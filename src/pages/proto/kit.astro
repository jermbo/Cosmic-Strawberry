	<script>
		import { drawFigure, assembleStripe } from "../../lib/proto/reveal";
		import gsap from "gsap";

		const stage = document.querySelector(".kit-stage");
		const replay = document.querySelector("[data-replay]");

		replay?.addEventListener("click", () => {
			if (!stage) return;
			stage.querySelectorAll(".stripe").forEach((s) => assembleStripe(s));
			stage.querySelectorAll("[data-fig]").forEach((f) => drawFigure(f));
			const rule = stage.querySelector(".rule");
			if (rule) gsap.fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.9, ease: "expo.out" });
		});
	</script>
