---
import CosmicLogo from "../components/CosmicLogo.astro";
import AsciiLogo from "../components/AsciiLogo.astro";
import "../styles/landing.css";
---

<html lang="en" class="preload">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cosmic Strawberry</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<canvas class="starfield" aria-hidden="true"></canvas>
		<div class="streak" aria-hidden="true"></div>

		<main class="console">
			<header class="console-head" aria-hidden="true">
				<span>CS-NAV</span>
				<span>FW 0.0.1</span>
				<span class="link">◉ LINK</span>
			</header>

			<div class="boot" aria-hidden="true"></div>

			<section class="hero">
				<div class="logo-stack">
					<AsciiLogo />
					<CosmicLogo />
				</div>
				<p class="strawberry">strawberry</p>
				<p class="coming-soon">coming soon</p>
			</section>

			<footer class="commands" aria-hidden="true">
				<span>[CLICK] JUMP</span>
				<span>[TYPE] STRAWBERRY</span>
			</footer>
		</main>

		<div class="flash" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>

		<script>
			import { createStarfield } from "../lib/starfield";
			import { playBoot } from "../lib/boot";
			import { initInteractions } from "../lib/interactions";

			const canvas = document.querySelector<HTMLCanvasElement>(".starfield");
			if (!canvas) {
				throw new Error("starfield canvas missing");
			}

			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const starfield = createStarfield(canvas, { twinkle: !reduced });

			if (reduced) {
				document.documentElement.classList.remove("preload");
			} else {
				const boot = playBoot(document.body);
				const flash = document.querySelector(".flash");
				const stage = document.querySelector(".hero");

				if (flash && stage) {
					initInteractions({ root: document.body, starfield, boot, flash, stage });
				}
			}
		</script>
	</body>
</html>
