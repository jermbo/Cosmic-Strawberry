---
import type { TalkBlock, TalkAccent } from "../../../lib/proto/talks/ast";
import StepBlocks from "./StepBlocks.astro";

interface Props {
	block: TalkBlock;
	accent?: TalkAccent;
}

const { block, accent = "purple" } = Astro.props;
---

<StepBlocks
	items={block.children ?? []}
	accent={accent}
	class="layout-letters__row"
	molecule="letters"
/>
