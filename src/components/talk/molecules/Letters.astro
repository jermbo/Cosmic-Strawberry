---
import type { TalkBlock } from "../../../lib/proto/talks/ast";
import { pickMotion } from "../../../lib/proto/talks/ast";
import Step from "../Step.astro";

interface Props {
	block: TalkBlock;
}

const { block } = Astro.props;
const items = block.children ?? [];
---

<div class="layout-letters__row" data-molecule="letters">
	{
		items.map((child) => (
			<Step on={!!child.step} motion={pickMotion(child.attrs)}>
				<div class="letter-card">
					<span class="letter-card__char">{child.letter ?? child.label}</span>
					<span class="letter-card__label">{child.body}</span>
				</div>
			</Step>
		))
	}
</div>
