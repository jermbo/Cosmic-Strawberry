---
import type { TalkBlock } from "../../../lib/proto/talks/ast";
import { pickMotion } from "../../../lib/proto/talks/ast";
import Step from "../Step.astro";

interface Props {
	block: TalkBlock;
}

const { block } = Astro.props;
const items = block.children ?? [];
---

<div class="alt-stack" data-molecule="altitude">
	{
		items.map((child) => (
			<Step on={!!child.step} motion={pickMotion(child.attrs)}>
				<div class="alt-row">
					<span class="alt-row__label">{child.label}</span>
					<p class="alt-row__body">{child.body}</p>
				</div>
			</Step>
		))
	}
</div>
