---
import type { TalkBlock, TalkAccent } from "../../../lib/proto/talks/ast";

interface Props {
	block: TalkBlock;
	accent: TalkAccent;
}

const { block, accent } = Astro.props;
const cardAccent = block.accent ?? accent;
---

<article class="recap-card" data-accent={cardAccent} data-molecule="recap-card">
	<h3>{block.label}</h3>
	<p>{block.body}</p>
</article>
