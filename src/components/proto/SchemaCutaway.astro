---
/**
 * Essay diagram — full longitudinal cutaway, four numbered callouts.
 * Callout groups carry data-callout so the scroll wiring can light the
 * one belonging to the section currently in the reading position.
 */
const wallL = Array.from({ length: 27 }, (_, i) => 132 + i * 14);
const wallR = Array.from({ length: 27 }, (_, i) => 132 + i * 14);

const lattice: { x: number; y: number }[] = [];
for (let r = 0; r < 3; r++) {
	for (let c = 0; c < 5; c++) {
		lattice.push({ x: 178 + c * 25, y: 384 + r * 21 });
	}
}

const coils = [0, 1, 2, 3].map((i) => ({ y: 458 + i * 12, rx: 62 - i * 6 }));
---

<svg
	class="schema"
	viewBox="0 0 480 600"
	role="img"
	aria-label="Longitudinal cutaway of a crossing vessel with four numbered callouts"
	data-fig
>
	<!-- registration marks -->
	<g class="ln ln--faint">
		<path d="M8 20 V8 H20" />
		<path d="M460 8 H472 V20" />
		<path d="M472 580 V592 H460" />
		<path d="M20 592 H8 V580" />
	</g>

	<!-- centreline -->
	<line class="ln ln--dash" x1="240" y1="18" x2="240" y2="572" />

	<!-- outer envelope -->
	<path class="ln" d="M150 116 Q240 22 330 116" />
	<line class="ln" x1="150" y1="116" x2="150" y2="500" />
	<line class="ln" x1="330" y1="116" x2="330" y2="500" />
	<path class="ln" d="M150 500 L138 528 L342 528 L330 500" />

	<!-- inner wall -->
	<path class="ln ln--faint" d="M164 124 Q240 46 316 124" />
	<line class="ln ln--faint" x1="164" y1="124" x2="164" y2="500" />
	<line class="ln ln--faint" x1="316" y1="124" x2="316" y2="500" />

	<!-- section hatch, both cut walls -->
	<g class="ln ln--faint">
		{wallL.map((y) => <line x1="150" y1={y} x2="164" y2={y - 14} />)}
		{wallR.map((y) => <line x1="316" y1={y} x2="330" y2={y - 14} />)}
	</g>

	<!-- bulkheads -->
	<g class="ln">
		<line x1="164" y1="196" x2="316" y2="196" />
		<line x1="164" y1="290" x2="316" y2="290" />
		<line x1="164" y1="366" x2="316" y2="366" />
		<line x1="164" y1="444" x2="316" y2="444" />
	</g>

	<!-- bay 01: intake stack -->
	<g class="ln ln--faint">
		<line x1="182" y1="140" x2="298" y2="140" />
		<line x1="192" y1="160" x2="288" y2="160" />
		<line x1="200" y1="178" x2="280" y2="178" />
	</g>

	<!-- bay 02: resonator assembly -->
	<circle class="ln" cx="240" cy="243" r="34" />
	<circle class="ln ln--faint" cx="240" cy="243" r="21" />
	<circle class="fill-orange" cx="240" cy="243" r="4" />
	<g class="ln ln--faint">
		<line x1="206" y1="243" x2="174" y2="243" />
		<line x1="274" y1="243" x2="306" y2="243" />
		<line x1="240" y1="209" x2="240" y2="202" />
		<line x1="240" y1="277" x2="240" y2="284" />
	</g>

	<!-- bay 03: lattice -->
	<g class="ln ln--faint">
		{lattice.map((c) => <rect x={c.x} y={c.y} width="11" height="11" />)}
	</g>

	<!-- bay 04: exit coils -->
	<g class="ln ln--faint">
		{coils.map((c) => <ellipse cx="240" cy={c.y} rx={c.rx} ry="5" />)}
	</g>

	<!-- callout 01 -->
	<g class="callout" data-callout="1">
		<circle class="fill-fg" cx="240" cy="60" r="2.6" />
		<polyline class="ln" points="240,60 152,32 30,32" />
		<text class="txt" x="30" y="24">01 / APERTURE</text>
	</g>

	<!-- callout 02 -->
	<g class="callout" data-callout="2">
		<circle class="fill-fg" cx="274" cy="225" r="2.6" />
		<polyline class="ln" points="274,225 392,196 452,196" />
		<text class="txt" x="452" y="188" text-anchor="end">02 / RESONATOR</text>
	</g>

	<!-- callout 03 -->
	<g class="callout" data-callout="3">
		<circle class="fill-fg" cx="189" cy="400" r="2.6" />
		<polyline class="ln" points="189,400 96,432 30,432" />
		<text class="txt" x="30" y="424">03 / LATTICE</text>
	</g>

	<!-- callout 04 -->
	<g class="callout" data-callout="4">
		<circle class="fill-fg" cx="298" cy="482" r="2.6" />
		<polyline class="ln" points="298,482 396,514 452,514" />
		<text class="txt" x="452" y="506" text-anchor="end">04 / EXIT PLANE</text>
	</g>

	<!-- dimension run -->
	<g class="ln ln--faint">
		<line x1="138" y1="546" x2="138" y2="562" />
		<line x1="342" y1="546" x2="342" y2="562" />
		<line x1="138" y1="554" x2="206" y2="554" />
		<line x1="274" y1="554" x2="342" y2="554" />
	</g>
	<text class="txt" x="240" y="557" text-anchor="middle">2.400 M</text>

	<!-- scale bar -->
	<g class="ln ln--faint">
		<line x1="30" y1="566" x2="94" y2="566" />
		<line x1="30" y1="562" x2="30" y2="570" />
		<line x1="62" y1="563" x2="62" y2="569" />
		<line x1="94" y1="562" x2="94" y2="570" />
	</g>
	<text class="txt" x="30" y="583">SCALE 1:24</text>
</svg>
